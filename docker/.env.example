# Copy to docker/.env and pass --env-file docker/.env to docker compose.
# Configure all three LLM values before starting a solve.
HOTMOUSE_LLM_BASE_URL=http://host.docker.internal:8000/v1
HOTMOUSE_LLM_API_KEY=replace-with-your-api-key
HOTMOUSE_LLM_MODEL=replace-with-your-model
# openai (Chat Completions), openai-responses, or anthropic-messages.
HOTMOUSE_LLM_API=openai
# Optional: low, medium or high. Empty omits the reasoning effort parameter.
HOTMOUSE_LLM_REASONING_EFFORT=

# Execution pool, simultaneous projects, and each project's share of the pool.
HOTMOUSE_WORKER_COUNT=6
HOTMOUSE_PROJECT_CONCURRENCY=2
HOTMOUSE_PROJECT_MAX_WORKERS=3
# Shared execution time across all workers/routes; 0 disables the budget.
HOTMOUSE_PROJECT_BUDGET_SECONDS=1200

# Worker runtime limits, in seconds except attempt/retry counts.
HOTMOUSE_DECIDE_TIMEOUT_SECONDS=300
HOTMOUSE_EXECUTE_TIMEOUT_SECONDS=300
HOTMOUSE_CONCLUDE_TIMEOUT_SECONDS=90
HOTMOUSE_CONCLUDE_RESERVE_SECONDS=0
HOTMOUSE_RECOVERY_ATTEMPTS=3
HOTMOUSE_FORMAT_RETRIES=1
HOTMOUSE_BASH_TIMEOUT_SECONDS=90

# Heartbeat leases and provider retry delays, in seconds.
HOTMOUSE_STEP_TIMEOUT_SECONDS=15
HOTMOUSE_DECIDE_LEASE_TIMEOUT_SECONDS=15
HOTMOUSE_WORKER_UNHEALTHY_RETRY_AFTER_SECONDS=5
HOTMOUSE_WORKER_REJECTED_RETRY_AFTER_SECONDS=5

# Optional custom model context size for Pi and OptChat.
# PI_MODEL_CONTEXT_WINDOW=200000

HOTMOUSE_PORT=9981
HOTMOUSE_AUTORUN=1
HOTMOUSE_AUTH_REQUIRED=1
HOTMOUSE_LOG_LEVEL=debug
HOTMOUSE_LOG_ENV=1

# Optional TSec competition. Mount the rules file at this container path.
# BENCHMARK_BASE_URL=https://benchmark.example
# BENCHMARK_TOKEN=replace-with-your-benchmark-token
# HOTMOUSE_COMPETITION_RULES_FILE=/data/rules.md
# HOTMOUSE_COMPETITION_PLATFORM=tsec
# Competition uses PROJECT_CONCURRENCY and PROJECT_MAX_WORKERS unless overridden.
# HOTMOUSE_COMPETITION_CONCURRENCY=2
# HOTMOUSE_COMPETITION_MAX_WORKERS=3
HOTMOUSE_COMPETITION_CHALLENGE_TIMEOUT=20m
