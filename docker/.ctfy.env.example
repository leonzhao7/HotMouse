# Copy to docker/.ctfy.env (chmod 600). Never bake credentials into the image.
CTFY_TOKEN=pf_replace-with-agent-play-token
# Optional when exactly one registered upcoming/running competition is visible.
CTFY_COMPETITION_ID=
CTFY_BASE_URL=https://ctfy.tsinghua.edu.cn/api/v1

# Copy the COMPLETE gateway URL and session credential from the platform.
# The URL is passed verbatim; do not append /v1 unless the platform includes it.
OPENAI_BASE_URL=https://replace-with-platform-session-gateway
OPENAI_API_KEY=pk_replace-with-session-credential
CTFY_MODEL=replace-with-platform-model-id
HOTMOUSE_LLM_API=openai
# Optional: low, medium or high. Empty omits the reasoning effort parameter.
HOTMOUSE_LLM_REASONING_EFFORT=
# For Anthropic set HOTMOUSE_LLM_API=anthropic-messages and use instead:
# ANTHROPIC_BASE_URL=https://replace-with-platform-session-gateway
# ANTHROPIC_API_KEY=pk_replace-with-session-credential
# For OpenAI Responses set HOTMOUSE_LLM_API=openai-responses.

CTFY_VPN_MODE=auto
CTFY_POLL_SECONDS=15
CTFY_RETRY_SECONDS=120
CTFY_CHALLENGE_TIMEOUT_SECONDS=1200
CTFY_START_TIMEOUT_SECONDS=600
HOTMOUSE_LOG_LEVEL=info
HOTMOUSE_LOG_ENV=0

# Optional automatic authoring for the agent track; requires its own token.
CTFY_AUTHOR_ENABLED=0
CTFY_AUTHOR_TOKEN=
CTFY_AUTHOR_CATEGORY=web
CTFY_AUTHOR_STACK=python-flask
CTFY_AUTHOR_LICENSE=platform-only
# Copy the competition's actual contributor agreement version if required.
CTFY_TERMS_VERSION=
