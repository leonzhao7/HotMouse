# Fill these before starting the container. No input is requested after startup.
# Compose: docker compose --env-file docker/.tsec.env -f docker/tsec.compose.yaml up -d --no-build
# All settings support startup overrides: startup environment > this file > image defaults.
# Docker run: use --env-file docker/.tsec.env and --env KEY=value for overrides.
BENCHMARK_BASE_URL=https://your-tsec-platform.example
BENCHMARK_TOKEN=replace-with-the-benchmark-task-token

# Native Pi model gateway; the base URL is passed through without adding /v1.
HOTMOUSE_LLM_BASE_URL=http://127.0.0.1:8000/v1
HOTMOUSE_LLM_API_KEY=replace-with-the-model-api-key
HOTMOUSE_LLM_MODEL=replace-with-the-model-id
HOTMOUSE_LLM_API=openai
# Optional: low, medium or high. Empty omits the reasoning effort parameter.
HOTMOUSE_LLM_REASONING_EFFORT=

# The host is already connected to TSec's VPN. The Compose service uses host
# networking. An optional HTTP(S) VPN health endpoint is retried until reachable.
TSEC_VPN_MODE=external
TSEC_NETWORK_CHECK_URL=

# Disable background target analysis, TCP liveness monitoring and homepage
# preprocessing. Set 1 to enable the workbench's automatic target probe pipeline.
TSEC_TARGET_PROBE_ENABLED=0

# TSec permits at most three simultaneous challenge instances. The global
# Worker pool and per-project budget are shared exactly as in the workbench.
HOTMOUSE_COMPETITION_CONCURRENCY=3
HOTMOUSE_COMPETITION_MAX_WORKERS=3
HOTMOUSE_PROJECT_CONCURRENCY=3
HOTMOUSE_PROJECT_MAX_WORKERS=3
HOTMOUSE_WORKER_COUNT=16
HOTMOUSE_PROJECT_BUDGET_SECONDS=0
HOTMOUSE_COMPETITION_CHALLENGE_TIMEOUT=30m
TSEC_RETRY_INTERVAL=8s
TSEC_SHUTDOWN_TIMEOUT=30s
TSEC_RESULT_FILE=/data/tsec-result.json

HOTMOUSE_LOG_LEVEL=info
HOTMOUSE_LOG_ENV=0
