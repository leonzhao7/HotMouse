!docker/entrypoint.sh
!LICENSE

# Exclude local state even when it is nested inside an allowed source directory.
**/.env
**/.env.*
**/.git
**/node_modules
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
